# RPCs (public endpoints work; a keyed provider is more reliable for the live demo)
SEPOLIA_RPC_URL=https://sepolia.gateway.tenderly.co
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ETHERSCAN_API_KEY=

# Deployer / executor (testnet burner only). Needs Sepolia ETH + LINK, and Base Sepolia ETH.
PRIVATE_KEY=
# Signers whose roles are delegated through the DAO's ENSv2 name
APPROVER_PRIVATE_KEY=
AUDITOR_PRIVATE_KEY=

# Optional
ENS_LABEL=nidhi-dao
# ANTHROPIC_API_KEY=   # enables the advisory LLM review in offchain/src/audit.ts
# GITHUB_TOKEN=        # raises GitHub API rate limits for the auditor
